# ---- Shopify (Brands Warehouse) ----
# Admin API access token from a custom app with read/write products + inventory.
SHOPIFY_STORE=brands-warehouse.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-07
SHOPIFY_LOCATION_ID=gid://shopify/Location/52596932776

# ---- Ace (dropship supplier) ----
# Fill these in from the Ace dealer portal. See config/suppliers.yaml for how
# they are used; nothing here is ever committed.
ACE_BASE_URL=
ACE_AUTH_MODE=bearer          # bearer | basic | session | file
ACE_TOKEN=
ACE_USERNAME=
ACE_PASSWORD=
