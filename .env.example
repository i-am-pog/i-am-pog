# ---- Shopify (Brands Warehouse) ----
# Admin API access token from a custom app with read/write products + inventory.
SHOPIFY_STORE=brands-warehouse.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-07
SHOPIFY_LOCATION_ID=gid://shopify/Location/52596932776

# ---- Ace (acegiftsplus.ca) ----
# A dealer SESSION COOKIE, not a password. Log in with your own browser, open
# devtools > Application > Cookies, and copy the session cookie value. It
# expires on its own and logging out revokes it, which a password does not.
#
# Never put a password here. Nothing in this pipeline needs one.
ACE_SESSION_COOKIE=

# Only if Ace turns out to have a separate dealer API (the `ace_api` supplier).
ACE_BASE_URL=
ACE_AUTH_MODE=bearer          # bearer | header | basic | session | none
ACE_TOKEN=

# ---- Other stock sources ----
ONHAND_SHEET_CSV_URL=
CONSIGNMENT_SHEET_CSV_URL=
